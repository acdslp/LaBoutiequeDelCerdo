# ===== Base de datos MySQL =====
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=lbdc

# ===== Claude API (el cerebro de Bouti) =====
# Crear una API key en https://platform.claude.com
ANTHROPIC_API_KEY=
BOT_MODEL=claude-opus-5
# Esfuerzo de razonamiento: low | medium | high (low = mas rapido y economico)
BOT_EFFORT=low

# ===== Negocio =====
# Tasa Bs/USD de referencia (luego se puede automatizar con la API del BCV)
TASA_BS=160
# Archivo Excel exportado del sistema SYH
XLS_PATH=../BOUTIQUE.xls
# Hoja del Excel con los precios del sistema
XLS_HOJA=PRECIOS SISTEMA

# ===== WhatsApp Business Cloud API (Meta) =====
# Se obtienen en https://developers.facebook.com al crear la app de WhatsApp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Token inventado por nosotros para verificar el webhook (cualquier texto secreto)
WEBHOOK_VERIFY_TOKEN=bouti-lbdc-2026

PORT=3000
